---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Blog sobre software contable.' } = Astro.props;
const siteName = 'ContaBlog';
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com').toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · {siteName}</title>
  </head>

  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/">{siteName}</a>
        <nav class="nav" aria-label="Navegación principal">
          <a href="/comparativas">Comparativas</a>
          <a href="/blog">Blog</a>
          <a href="/about">Acerca de</a>
        </nav>
        <button id="theme-toggle" class="theme-toggle" aria-label="Cambiar tema">
            🌙
          </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>© {new Date().getFullYear()} {siteName}. Todos los derechos reservados.</p>
      </div>
    </footer>
    <script is:inline>
    const themeToggle = document.getElementById('theme-toggle');
    const htmlElement = document.documentElement;

    // 1. Revisar si el usuario ya tenía una preferencia guardada
    const currentTheme = localStorage.getItem('theme');
    if (currentTheme) {
      htmlElement.setAttribute('data-theme', currentTheme);
      if (currentTheme === 'dark') themeToggle.textContent = '☀️';
    }

    // 2. Escuchar el clic del botón
    themeToggle.addEventListener('click', () => {
      const isDark = htmlElement.getAttribute('data-theme') === 'dark';
      
      if (isDark) {
        // Cambiar a claro
        htmlElement.removeAttribute('data-theme');
        localStorage.setItem('theme', 'light');
        themeToggle.textContent = '🌙';
      } else {
        // Cambiar a oscuro
        htmlElement.setAttribute('data-theme', 'dark');
        localStorage.setItem('theme', 'dark');
        themeToggle.textContent = '☀️';
      }
    });
  </script>
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #fec3c3;
    --color-fg: #0f172a;
    --color-muted: #475569;
    --color-border: #e2e8f0;
    --color-primary: #d1057f;
    --color-primary-hover: #a02499;
    --color-surface: #f8fafc;
    --radius: 12px;
    --shadow-lg: 0 10px 30px rgba(15, 23, 42, 0.08);
    --max-width: 1100px;
    --font-sans: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }

  html[data-theme="dark"] {
    --color-bg: #0b1120;
    --color-fg: #e2e8f0;
    --color-muted: #94a3b8;
    --color-border: #1e293b;
    --color-primary: #a855f7; 
    --color-primary-hover: #c084fc;
    --color-surface: #111827;
  }

  *, *::before, *::after { box-sizing: border-box; }

  body {
    margin: 0;
    font-family: var(--font-sans);
    background: var(--color-bg);
    color: var(--color-fg);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a { color: inherit; text-decoration: none; }
  a:hover { color: var(--color-primary); }
  h1, h2, h3 { line-height: 1.2; margin: 0 0 0.5em; }

  .container {
    width: 100%;
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  .skip-link {
    position: absolute;
    top: -100px;
    left: 0;
    background: var(--color-primary);
    color: white;
    padding: 0.5rem 1rem;
    z-index: 100;
  }
  .skip-link:focus { top: 0; }

  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1rem;
    gap: 1rem;
  }
  .brand { font-weight: 700; font-size: 1.125rem; }
  .nav { display: flex; gap: 1.5rem; font-size: 0.95rem; color: var(--color-muted); }

  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: 4rem;
    padding-block: 2rem;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .nav { gap: 1rem; font-size: 0.875rem; }
  }
    .theme-toggle {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-fg);
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 50%;
    font-size: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    transition: all 0.2s ease;
  }
  
  .theme-toggle:hover {
    background: var(--color-border);
  }
</style>